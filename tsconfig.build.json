{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Workflows are compiled with the runtime: they are versioned repo code, reviewed
    // and type-checked like the rest, not scripts loaded from an untyped directory.
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "workflows/**/*.ts"]
}
