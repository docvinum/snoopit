%% Détail — recovery : remettre un script sur ses rails
%% Fichier : src/runtime/recovery/recover.ts
%% Recovery déterministe : l'appelant externe décide de la suite après un échec.

flowchart TD
  entry["recover(page, opts)<br/>allowedActions ⊆ {click, scroll, close_overlay}"]

  reached0{"recover.ts expectedStateReached()<br/>query(selector) + isHumanInteractable (interactable.ts:71)"}
  noop["déjà dans l'état ⇒ retour immédiat (level: null)"]

  notblocked["assertNotBlocked(page)<br/>BLOCKING_PROBE_SELECTORS → detectBlocking (blocking.ts:95)<br/>site qui refuse ⇒ throw BlockedError — jamais contourné, jamais réessayé"]

  subgraph L1["L1 — déterministe"]
    l1_dismiss["dismissOverlays(page) — heuristics.ts:233<br/>bannières cookies / modales"]
    l1_scroll["si 'scroll' permis : page.scroll('bottom')"]
    l1_check{"expectedStateReached ?"}
  end

  l4["L4 — throw RecoveryFailedError<br/>(loggé, rapporté, le run s'arrête honnêtement)"]

  done["retour RecoveryOutcome { recovered:true, level, steps }"]

  entry --> reached0
  reached0 -->|oui| noop
  reached0 -->|non| notblocked --> l1_dismiss --> l1_check
  l1_check -->|non| l1_scroll --> l1_check
  l1_check -->|oui| done
  l1_check -->|"toujours non"| l4
