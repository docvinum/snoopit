# ── Node / TypeScript ─────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output (anchored: a bare `dist/` would also match a nested source dir).
/dist/
/build/
/out/

# TypeScript incremental build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Test coverage
/coverage/
*.lcov

# Caches
.eslintcache
.cache/
.npm/
.node_repl_history

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Optional npm/publish artifacts
*.tgz

# Environment variables
.env
.env.*
!.env.example

# ── Editors / OS ──────────────────────────────────────────────────────────────

.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── snoopit ───────────────────────────────────────────────────────────────────
#
# Note: keep directory patterns anchored with a leading slash. Unanchored,
# `downloads/` once matched `src/runtime/downloads/` and silently kept a whole
# module out of every commit for five lots. `tests/unit/repo-hygiene.test.ts`
# now fails if any source file becomes ignored again.

# Runtime state: the database, artifacts and run directories.
data/

# Local configuration; commit snoopit.config.example.yaml instead.
snoopit.config.yaml

# Local agent/editor state: personal Claude Code settings and its git worktrees.
# `skills/` and `AGENTS.md` at the repo root are the shared, committed pieces.
.claude/
