# One pass of the scheduler: run every job that is due, then exit.
#
# Type=oneshot rather than a long-lived daemon. The scheduler holds no state between
# passes — what is due is derived from the database and the clock — so a process that
# starts, works and exits has nothing to lose when it is killed, and nothing to leak
# when it runs for months.

[Unit]
Description=snoopit — run due jobs
After=snoopit-chrome.service
Requires=snoopit-chrome.service

[Service]
Type=oneshot
User=snoopit
Group=snoopit

Environment=NODE_ENV=production
WorkingDirectory=/opt/snoopit

# The LLM key lives here, readable only by the service user. It is never in the
# config file, which names the variable rather than holding the value.
EnvironmentFile=-/etc/snoopit/snoopit.env

ExecStart=/usr/bin/node /opt/snoopit/dist/src/cli/main.js tick --config /etc/snoopit/snoopit.config.yaml

# A run that hangs must not block every later tick.
TimeoutStartSec=3600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/snoopit
