{
  // The extension runs in Chrome, not Node: its own lib and types. The shared files
  // it imports from src/ (protocol.ts, page-functions.ts) are compiled with it and
  // copied next to it by scripts/build-extension.mjs.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "rootDir": "..",
    "outDir": "../dist/.extension-build",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "../src/runtime/browser/extension/protocol.ts",
    "../src/runtime/browser/page-functions.ts",
    "../src/runtime/browser/interactable.ts"
  ]
}
